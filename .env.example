# PostgreSQL local. Substitua a senha antes de iniciar o container.
POSTGRES_DB=locacaocarros
POSTGRES_USER=locacaocarros
POSTGRES_PASSWORD=defina_uma_senha_local
POSTGRES_PORT=5433

# Uso futuro pela aplicação.
DATABASE_URL=postgresql://locacaocarros:defina_uma_senha_local@127.0.0.1:5433/locacaocarros

# Uso exclusivo por comandos do Drizzle Kit e migrations.
MIGRATION_DATABASE_URL=postgresql://locacaocarros:defina_uma_senha_local@127.0.0.1:5433/locacaocarros

# Banco local separado, criado manualmente conforme o README.
TEST_DATABASE_URL=postgresql://locacaocarros:defina_uma_senha_local@127.0.0.1:5433/locacaocarros_test
