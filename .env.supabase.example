# Identificação pública do projeto
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_PROJECT_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_PUBLISHABLE_KEY=publishable_key_ficticia_para_exemplo

# Credencial futura da aplicação no servidor
# Não é necessária para migrations e pode permanecer sem preenchimento até a
# implementação do adapter remoto da aplicação. Nunca use NEXT_PUBLIC em segredos.
SUPABASE_SECRET_KEY=secret_key_ficticia_para_uso_futuro

# Migration remota
# O arquivo .env.supabase.local pode inicialmente conter somente PROJECT_REF e
# as duas variáveis abaixo, que são as únicas necessárias à migration.
SUPABASE_MIGRATION_DATABASE_URL=postgresql://postgres.abcdefghijklmnopqrst:senha_ficticia@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_REMOTE_MIGRATION_CONFIRMATION=locacao_carros:abcdefghijklmnopqrst
